; Import library for the fixture: functions of the console's xmem.dll, which the loader routes to
; our implementation.
LIBRARY xmem.dll
EXPORTS
    XMemAlloc
    XMemFree
    XMemVirtualAlloc
    XMemVirtualQuery
    XMemAllocatePhysicalPages
    XMemFreePhysicalPages
    XMemMapPhysicalPages
    XMemGetWorkingSetStatistics
